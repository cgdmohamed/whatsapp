# API environment for docker-compose.
#
# Committed with safe development placeholders so `docker compose up -d` works
# out of the box. Before exposing to untrusted networks, replace every secret
# below (ACCESS_TOKEN_SECRET, APP_ENCRYPTION_KEY, POSTGRES_PASSWORD, ...).
#   openssl rand -base64 48   (ACCESS_TOKEN_SECRET)
#   openssl rand -hex 32      (APP_ENCRYPTION_KEY, exactly 64 hex chars)

# --- Runtime ---
NODE_ENV=production
PORT=4000
# Comma-separated allowed browser origins (web container is served on 8080).
WEB_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
TRUST_PROXY=1

# --- Database / Redis ---
DATABASE_URL=postgresql://whatsapp:change-me-now@postgres:5432/whatsapp
REDIS_URL=redis://redis:6379

# --- Authentication ---
ACCESS_TOKEN_SECRET=dev-only-placeholder-access-token-secret-replace-123456
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=false

# --- API surface ---
SWAGGER_ENABLED=true
RATE_LIMIT_DISABLED=false

# --- Meta WhatsApp Business Cloud API (optional, connect via dashboard) ---
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0

# --- Media / data directories (absolute, matched to compose volumes) ---
EXPORTS_DIR=/app/apps/api/exports
IMPORT_UPLOAD_DIR=/app/apps/api/data/imports
INBOX_MEDIA_DIR=/app/apps/api/data/inbox-media
INBOX_MEDIA_SIGNING_SECRET=

# --- Transactional email (optional) ---
APP_PUBLIC_URL=http://localhost:8080
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
MAIL_REPLY_TO=

# --- Seed (idempotent admin bootstrap). Only read by `pnpm db:seed`. ---
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
