# Environment variables for the WhatsApp Campaign Manager API.
#
# These are configured as Coolify Environment Variables in the dashboard.
# docker-compose.yaml reads them via ${VAR} interpolation — no env_file is used.
#
# Copy this file as a reference when setting up Coolify.
# Never commit real secrets to version control.

# =============================================================================
# REQUIRED — must be set in Coolify before first deploy
# =============================================================================

# Comma-separated allowed browser origins (e.g. "https://app.example.com").
WEB_ORIGIN=

# Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=

# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# PostgreSQL password — must match POSTGRES_PASSWORD on the postgres service.
POSTGRES_PASSWORD=change-me-now

# =============================================================================
# OPTIONAL — safe defaults are provided if unset
# =============================================================================

# --- Runtime (defaults are production-ready) ---
# NODE_ENV=production
# PORT=4000
# TRUST_PROXY=1

# --- Authentication ---
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# --- Logging ---
# LOG_LEVEL=info
# LOG_PRETTY=false

# --- API surface ---
# SWAGGER_ENABLED=true
# RATE_LIMIT_DISABLED=false

# --- Meta WhatsApp Business Cloud API (optional) ---
# Leave blank (or unset) to connect Meta via the dashboard at Settings > WhatsApp.
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_ACCESS_TOKEN=
# META_WABA_ID=
# META_PHONE_NUMBER_ID=
# META_GRAPH_API_VERSION=v21.0

# --- Media / data directories (absolute paths, matched to compose volumes) ---
# EXPORTS_DIR=/app/apps/api/exports
# IMPORT_UPLOAD_DIR=/app/apps/api/data/imports
# INBOX_MEDIA_DIR=/app/apps/api/data/inbox-media
# INBOX_MEDIA_SIGNING_SECRET=

# --- Transactional email (optional) ---
# APP_PUBLIC_URL=
# MAIL_ENABLED=false
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_SECURE=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=
# MAIL_REPLY_TO=

# --- Seed (idempotent admin bootstrap, only read by `pnpm db:seed`) ---
# SEED_ADMIN_NAME=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
