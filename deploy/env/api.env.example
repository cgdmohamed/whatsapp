# Template for the API environment used by docker-compose.
# Copy to ./deploy/env/api.env and fill in real values (never commit api.env).

# --- Runtime ---
NODE_ENV=production
PORT=4000
# REQUIRED: comma-separated allowed browser origins.
WEB_ORIGIN=https://whatsapp.example.com
TRUST_PROXY=1

# --- Database / Redis ---
# REQUIRED: PostgreSQL connection string.
DATABASE_URL=postgresql://whatsapp:change-me-now@postgres:5432/whatsapp
# REQUIRED: Redis connection string.
REDIS_URL=redis://redis:6379

# --- Authentication (REQUIRED: generate fresh secrets) ---
#   openssl rand -base64 48   (access token secret, min 32 chars)
#   openssl rand -hex 32      (app encryption key, exactly 64 hex chars)
ACCESS_TOKEN_SECRET=replace-with-a-long-random-base64-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
APP_ENCRYPTION_KEY=replace-with-64-hex-chars

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=false

# --- API surface ---
SWAGGER_ENABLED=true
RATE_LIMIT_DISABLED=false

# --- Meta WhatsApp Business Cloud API (optional) ---
# Leave blank (or unset) to connect Meta via the dashboard at Settings > WhatsApp.
# Blank values are treated as "not configured"; values stored in the dashboard take precedence.
# NOTE: the access token and WABA ID are always taken from the dashboard, never from env.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0

# --- Media / data directories (optional, defaults shown) ---
EXPORTS_DIR=./exports
IMPORT_UPLOAD_DIR=./data/imports
INBOX_MEDIA_DIR=./data/inbox-media
# Required only when serving inbox media through the API (>= 32 chars).
INBOX_MEDIA_SIGNING_SECRET=

# --- Transactional email (optional) ---
# Public URL used to build password-reset links.
APP_PUBLIC_URL=https://whatsapp.example.com
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
MAIL_REPLY_TO=

# --- Seed (idempotent admin bootstrap). Only read by `pnpm db:seed`. ---
# All three must be provided together, or all left blank.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@whatsapp.example.com
SEED_ADMIN_PASSWORD=change-me-now-2026
