{
  "name": "whatsapp-campaign-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted WhatsApp campaign management and team inbox platform (Meta WhatsApp Business Cloud API)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --filter @wa/config --filter @wa/shared --filter @wa/ui --filter @wa/api --filter @wa/web run dev",
    "dev:api": "pnpm --filter @wa/api dev",
    "dev:web": "pnpm --filter @wa/web dev",
    "build": "pnpm -r --sort run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @wa/api test",
    "test:watch": "pnpm --filter @wa/api test:watch",
    "db:generate": "pnpm --filter @wa/api db:generate",
    "db:migrate": "pnpm --filter @wa/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @wa/api db:migrate:deploy",
    "db:seed": "pnpm --filter @wa/api db:seed",
    "db:reset": "pnpm --filter @wa/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2"
  }
}
