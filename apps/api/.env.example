# --- Runtime ---
# REQUIRED: allowed browser origins, comma-separated.
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=4000
# api (default) serves HTTP and runs background workers; worker disables the
# HTTP server and runs only BullMQ workers (used for a separate PM2 process).
PROCESS_ROLE=api
# Number of trusted proxy hops when running behind a reverse proxy (0 disables).
TRUST_PROXY=0

# --- Database / Redis ---
# REQUIRED: PostgreSQL connection string.
DATABASE_URL=postgresql://whatsapp:whatsapp_dev@localhost:5432/whatsapp_dev
# REQUIRED: Redis connection string.
REDIS_URL=redis://localhost:6379

# --- Authentication ---
# REQUIRED: at least 32 characters. Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=LG25IGvP4uM9lP2VzT5of44UYRQlJmkihrFZI5L+Ue43Bjz8sW7xtKcinypprjkv
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Encryption (AES-256-GCM) ---
# REQUIRED: exactly 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=7c8f4f8d103ded730903806db51a7ebf03be36a0509ec3f8dc3fc9e0640202b4

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true

# --- API surface ---
SWAGGER_ENABLED=true
RATE_LIMIT_DISABLED=false

# --- Transactional email (optional) ---
# Public URL used to build password-reset links.
APP_PUBLIC_URL=http://localhost:5173
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
MAIL_REPLY_TO=
# Worker concurrency for the transactional-email queue (default 3).
MAIL_WORKER_CONCURRENCY=3

# --- Meta WhatsApp Business Cloud API (optional) ---
# Leave blank (or unset) to connect Meta via the dashboard at Settings > WhatsApp.
# Blank values are treated as "not configured"; values stored in the dashboard take precedence.
# NOTE: the access token and WABA ID are always taken from the dashboard, never from env.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0

# --- Media / data directories (optional, defaults shown) ---
EXPORTS_DIR=./exports
IMPORT_UPLOAD_DIR=./data/imports
INBOX_MEDIA_DIR=./data/inbox-media
# Required only when serving inbox media through the API (>= 32 chars).
INBOX_MEDIA_SIGNING_SECRET=

# --- Seed (idempotent admin bootstrap). Only read by `pnpm db:seed`. ---
# All three must be provided together, or all left blank.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@whatsapp.local
SEED_ADMIN_PASSWORD=ChangeMeNow_2026!
